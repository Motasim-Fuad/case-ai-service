  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "description": {
            "type": "string",
            "title": "Description",
            "description": "What is being requested / must be done."
          },
          "requested_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested By"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date",
            "description": "ISO date YYYY-MM-DD if explicit, else null."
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "ref": {
            "type": "string",
            "title": "Ref",
            "default": ""
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "description",
          "requested_by",
          "due_date",
          "evidence",
          "confidence"
        ],
        "title": "ActionRequest"
      },
      "Amount": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Plain number, no currency symbol or thousands separators."
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency",
            "description": "ISO 4217 code, e.g. USD, if determinable."
          },
          "amount_type": {
            "type": "string",
            "enum": [
              "claimed",
              "paid",
              "deductible",
              "premium",
              "demand",
              "estimate",
              "medical_charge",
              "limit",
              "other"
            ],
            "title": "Amount Type"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "ref": {
            "type": "string",
            "title": "Ref",
            "default": ""
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "label",
          "amount",
          "currency",
          "amount_type",
          "evidence",
          "confidence"
        ],
        "title": "Amount"
      },
      "Body_process_upload_api_v1_dev_process_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF / JPG / PNG / TIFF / DOCX / TXT"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id",
            "default": "case-dev-1"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "send_webhook": {
            "type": "boolean",
            "title": "Send Webhook",
            "description": "Send the result to the built-in echo receiver.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_process_upload_api_v1_dev_process_upload_post"
      },
      "CaseEvent": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short label, max ~12 words."
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "event_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Date",
            "description": "ISO date YYYY-MM-DD only if the full date is explicit, else null."
          },
          "date_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Text",
            "description": "The date exactly as written in the document."
          },
          "event_type": {
            "type": "string",
            "enum": [
              "accident",
              "deadline",
              "request",
              "notice",
              "payment",
              "treatment",
              "inspection",
              "filing",
              "correspondence",
              "other"
            ],
            "title": "Event Type"
          },
          "is_deadline": {
            "type": "boolean",
            "title": "Is Deadline",
            "description": "True only if the document requires something BY this date."
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "ref": {
            "type": "string",
            "title": "Ref",
            "default": ""
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "title",
          "description",
          "event_date",
          "date_text",
          "event_type",
          "is_deadline",
          "evidence",
          "confidence"
        ],
        "title": "CaseEvent"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "ClaimDetails": {
        "properties": {
          "claim_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Number"
          },
          "policy_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Number"
          },
          "insurer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Insurer"
          },
          "insured_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Insured Name"
          },
          "date_of_loss": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Loss",
            "description": "ISO date YYYY-MM-DD if explicit, else null."
          },
          "loss_location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loss Location"
          },
          "vehicle_info": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vehicle Info"
          },
          "other": {
            "items": {
              "$ref": "#/components/schemas/KeyValue"
            },
            "type": "array",
            "title": "Other",
            "description": "Any other case-relevant fact not covered above."
          }
        },
        "type": "object",
        "required": [
          "claim_number",
          "policy_number",
          "insurer",
          "insured_name",
          "date_of_loss",
          "loss_location",
          "vehicle_info",
          "other"
        ],
        "title": "ClaimDetails"
      },
      "DeleteIndexResponse": {
        "properties": {
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": true
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "scope",
          "id"
        ],
        "title": "DeleteIndexResponse"
      },
      "DocumentExtractionResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "police_report",
              "insurance_letter",
              "claim_form",
              "policy_document",
              "medical_record",
              "medical_bill",
              "repair_estimate",
              "witness_statement",
              "legal_notice",
              "correspondence",
              "photo_or_image",
              "other"
            ],
            "title": "Document Type",
            "default": "other"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "parties": {
            "items": {
              "$ref": "#/components/schemas/Party"
            },
            "type": "array",
            "title": "Parties"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/CaseEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "amounts": {
            "items": {
              "$ref": "#/components/schemas/Amount"
            },
            "type": "array",
            "title": "Amounts"
          },
          "requests": {
            "items": {
              "$ref": "#/components/schemas/ActionRequest"
            },
            "type": "array",
            "title": "Requests"
          },
          "claim_details": {
            "$ref": "#/components/schemas/ClaimDetails"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageInfo"
            },
            "type": "array",
            "title": "Pages"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed"
            ],
            "title": "Processing Status",
            "default": "completed"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "case_id"
        ],
        "title": "DocumentExtractionResult"
      },
      "Evidence": {
        "properties": {
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "description": "Page number from the nearest [[PAGE n]] marker."
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote",
            "description": "Short VERBATIM excerpt (max 200 chars) that proves the item."
          }
        },
        "type": "object",
        "required": [
          "page",
          "quote"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed"
            ],
