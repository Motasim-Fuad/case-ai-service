# ============================================================================
#  Case AI Service - copy to `.env` and edit:   cp .env.example .env
#  FIRST RUN works with zero cloud accounts (MOCK_AI=true + local storage).
# ============================================================================
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true                    # false = human-readable logs in the terminal

# ---- Security (NestJS must send this in the X-Internal-Api-Key header) -------
INTERNAL_API_KEY=dev-internal-key        # PRODUCTION: long random secret (validated at startup)
WEBHOOK_SIGNING_SECRET=                  # optional: adds an HMAC `X-Signature` header to webhooks
CALLBACK_ALLOWED_HOSTS=                  # production: e.g. nestjs-api.internal,api.mycompany.com
ALLOWED_S3_BUCKETS=                      # optional extra buckets besides S3_BUCKET_NAME

# ---- Mode switch ---------------------------------------------------------------
MOCK_AI=true                     # true = offline heuristics (no OpenAI). false = REAL AI (needs OPENAI_API_KEY)
STORAGE_BACKEND=local            # local = ./data/uploads (dev) | s3 = AWS S3 (production)

# ---- OpenAI (needed when MOCK_AI=false) ----------------------------------------
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini     # any current model that supports Structured Outputs
OPENAI_QA_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=                  # optional (3-series models only). Changing it needs a NEW Qdrant collection.

# ---- AWS (needed for STORAGE_BACKEND=s3 and for OCR of scanned files) ------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# AWS_ENDPOINT_URL=                      # MinIO / LocalStack only
TEXTRACT_MODE=auto                       # auto | sync | async
TEXTRACT_ASYNC_PAGE_THRESHOLD=15         # more scanned pages than this (on S3) -> async Textract
MAX_TEXTRACT_WAIT_SECONDS=300

# ---- Limits -------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_PAGES=300

# ---- Infra (docker-compose overrides these automatically) -------------------------------
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=case_chunks
# Without Docker, the dev webhook echo lives on localhost:
DEV_WEBHOOK_ECHO_URL=http://localhost:8000/api/v1/dev/webhook-echo

# ---- Celery / performance ---------------------------------------------------------------
CELERY_TASK_MAX_RETRIES=3
CELERY_CONCURRENCY=2             # worker processes per container
WEB_CONCURRENCY=2                # gunicorn workers for the API
EXTRACTION_CONCURRENCY=3         # parallel GPT calls per long document
